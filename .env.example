# Formspree form ID — create a form at formspree.io pointing to contact@arixpro.com
# If empty, the contact form opens the visitor's mail client instead
VITE_FORMSPREE_ID=

# WhatsApp number in international format without + or spaces, e.g. 923001234567
# If empty, the WhatsApp button is hidden
VITE_WHATSAPP_NUMBER=
